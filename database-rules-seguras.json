{
  "rules": {
    "usuarios": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "vendas": {
      ".read": "auth != null",
      "$vendaId": {
        ".write": "auth != null"
      }
    },
    "equipes": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "planos": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "configuracoes": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "indices": {
      "cpf": {
        ".read": "auth != null",
        "$cpfNormalizado": {
          ".write": "auth != null && !data.exists()"
        }
      }
    }
  }
}
