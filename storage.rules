rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Permitir acesso para vendas - apenas o vendedor ou admin/gerente
    match /vendas/{vendedorId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == vendedorId ||
        isAdminOrManager()
      );
      allow delete: if request.auth != null && isAdminOrManager();
    }
    
    // Permitir acesso para uploads de usuários - apenas o próprio usuário ou admin
    match /uploads/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (
        request.auth.uid == userId ||
        isAdminOrManager()
      );
      allow delete: if request.auth != null && (
        request.auth.uid == userId ||
        isAdminOrManager()
      );
    }
    
    // Arquivos de configuração - apenas admin
    match /configuracoes/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }
    
    // Logos e assets públicos - leitura para todos autenticados, escrita apenas admin
    match /public/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }
    
    // Regra padrão - negar tudo
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

// Função auxiliar para verificar se é admin
function isAdmin() {
  return request.auth != null && 
    firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.funcao == 'ADMINISTRADOR_GERAL';
}

// Função auxiliar para verificar se é admin ou gerente
function isAdminOrManager() {
  return request.auth != null && (
    firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.funcao == 'ADMINISTRADOR_GERAL' ||
    firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.funcao == 'GERENTE'
  );
} 